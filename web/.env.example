# Salesforce sign-in for the hub's integration user (OAuth 2.0 JWT bearer). Never commit real values.
SF_LOGIN_URL=https://<my-domain>.sandbox.my.salesforce.com
SF_AUDIENCE=https://test.salesforce.com          # https://login.salesforce.com in production
SF_USERNAME=claimhub.integration@<org>
SF_CLIENT_ID=<External Client App consumer key>
SF_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Private invoice storage (decisions.md #6). S3 is used when its first three are set, else Blob, else Salesforce Files.
# S3 signs in through Vercel OIDC, so it works on Vercel only; leave it unset locally. No AWS keys, ever.
S3_BUCKET_NAME=                                  # trevor-claim-hub
S3_REGION=                                       # ap-southeast-2
AWS_ROLE_ARN=                                    # arn:aws:iam::<account>:role/trevor-claim-hub-sandbox (or -production)
S3_KEY_PREFIX=                                   # sandbox/ in the sandbox; unset in production
BLOB_READ_WRITE_TOKEN=
# 'production' hides the sandbox banner. HUB_HOME_SLUG sends the bare domain to one promotion (sandbox convenience).
HUB_ENV=
HUB_HOME_SLUG=
