# Salesforce sign-in for the hub's integration user (OAuth 2.0 JWT bearer). Never commit real values.
SF_LOGIN_URL=https://<my-domain>.sandbox.my.salesforce.com
SF_AUDIENCE=https://test.salesforce.com          # https://login.salesforce.com in production
SF_USERNAME=claimhub.integration@<org>
SF_CLIENT_ID=<External Client App consumer key>
SF_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Private invoice storage. Leave unset to keep invoices in Salesforce Files instead.
BLOB_READ_WRITE_TOKEN=
